# Supabase project settings (server-only except for the public anon key)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Generate a random value of at least 32 characters. Keep it server-only.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
OPENMAIL_PUBLIC_URL=https://YOUR-VERCEL-DOMAIN

# Resend API key with domain and inbound email access
RESEND_API_KEY=re_YOUR_KEY

# Signing secret for the Resend email.received webhook (whsec_...)
RESEND_WEBHOOK_SECRET=whsec_YOUR_SECRET
