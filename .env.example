# Supabase project settings. The publishable key is safe to expose, but this app
# reads it on the server. The secret key must remain server-only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Generate a random value of at least 32 characters. Keep it server-only.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
OPENMAIL_PUBLIC_URL=https://YOUR-VERCEL-DOMAIN

# Resend Full Access API key. Required to provision and verify customer domains
# and retrieve inbound message content. Store only as a server-side secret.
RESEND_API_KEY=re_YOUR_KEY

# Signing secret for the Resend email.received webhook (whsec_...)
RESEND_WEBHOOK_SECRET=whsec_YOUR_SECRET

# Optional Groq API key for AI reply drafts and opted-in automatic replies.
# Store this only as a server-side Vercel environment variable; never expose it
# to browser code. The model defaults to openai/gpt-oss-20b.
GROQ_API_KEY=gsk_YOUR_SECRET
# GROQ_MODEL=openai/gpt-oss-20b
