{
  "name": "openmail-site",
  "version": "1.0.0",
  "private": true,
  "description": "OpenMail React homepage, browser mailbox and Python AI backend",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.js",
    "test:python": ".venv/bin/python -m pytest -q",
    "dev:api": ".venv/bin/uvicorn main:app --reload --port 3000 --env-file .env.local",
    "prebuild": "node scripts/prepare_frontend.mjs",
    "build": "vite build && python3 scripts/build_static.py"
  },
  "dependencies": {
    "@vercel/functions": "3.10.6",
    "lucide-react": "1.71.0",
    "mammoth": "1.13.0",
    "motion": "14.12.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.7"
  }
}
