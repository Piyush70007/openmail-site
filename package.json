{
  "name": "openmail-site",
  "version": "1.0.0",
  "private": true,
  "description": "OpenMail browser assets and Node compatibility tests for the Python backend",
  "scripts": {
    "dev": ".venv/bin/uvicorn main:app --reload --port 3000 --env-file .env.local",
    "test": "node --test tests/*.test.js",
    "test:python": ".venv/bin/python -m pytest -q"
  },
  "dependencies": {
    "@vercel/functions": "3.10.6",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438"
  },
  "engines": {
    "node": "24.x"
  }
}
